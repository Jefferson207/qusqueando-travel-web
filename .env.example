# Upstash Redis (base compartida: cada proyecto usa su propio prefijo)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Acceso al panel /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Subida de imágenes desde el admin (endpoint de cPanel, campo "file")
CPANEL_UPLOAD_URL=
CPANEL_UPLOAD_TOKEN=

# Prefijo de las claves de este proyecto en Redis y secreto (mín. 32 caracteres) para firmar sesiones
CATALOG_KEY=catalogo:qusquea
SESSION_SECRET=

# Correos automáticos de reservas (opcional; sin esto las reservas igual se guardan y llegan por WhatsApp)
RESEND_API_KEY=
MAIL_FROM=Qusqueando Travel <reservas@qusqueandotravel.com>
